<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bubbleRoot"
    android:layout_width="58dp"
    android:layout_height="58dp"
    android:background="@drawable/bg_bubble"
    android:elevation="8dp">

    <ImageView
        android:id="@+id/bubbleIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_key"
        android:tint="@color/mint"
        android:contentDescription="@string/panel_title" />

    <View
        android:id="@+id/bubbleDot"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="9dp"
        android:layout_marginEnd="9dp"
        android:background="@drawable/bg_dot"
        android:visibility="gone" />

</FrameLayout>
